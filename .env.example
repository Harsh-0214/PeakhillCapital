# Copy to `.env.local` for local development. Never commit `.env.local`.

# Canonical origin. Used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.peakhillcapital.com"

# --- Contact form delivery (optional) ---------------------------------------
# The contact form validates, rate-limits and accepts submissions without these.
# Until RESEND_API_KEY is set, it responds with a "please email us directly"
# state rather than silently dropping the message.
#
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# CONTACT_FROM_EMAIL="website@peakhillcapital.com"
# CONTACT_TO_EMAIL="info@peakhillcapital.com"
